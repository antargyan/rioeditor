<Project>

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <!--
    Single source of truth for the product version.

    RioVersion is the semantic, user-visible version; RioBuild is a monotonic build number that
    the stores require to increase with every upload, independently of the display version.
    Both are plain properties, so CI overrides them from a tag without editing anything:

        dotnet build -p:RioVersion=1.2.0 -p:RioBuild=57

    (Command-line properties are global in MSBuild and win over the values below.)
  -->
  <PropertyGroup>
    <RioVersion>1.0.0</RioVersion>
    <RioBuild>1</RioBuild>

    <!-- .NET assembly identity -->
    <Version>$(RioVersion)</Version>
    <AssemblyVersion>$(RioVersion).0</AssemblyVersion>
    <FileVersion>$(RioVersion).$(RioBuild)</FileVersion>
    <InformationalVersion>$(RioVersion)</InformationalVersion>

    <!-- Apple: CFBundleShortVersionString / CFBundleVersion.
         Android: android:versionName / android:versionCode.
         The platform SDKs map these two properties onto those fields. -->
    <ApplicationDisplayVersion>$(RioVersion)</ApplicationDisplayVersion>
    <ApplicationVersion>$(RioBuild)</ApplicationVersion>
  </PropertyGroup>

  <!-- Single source of truth for every third-party version used by the solution. -->
  <PropertyGroup>
    <AvaloniaVersion>11.3.9</AvaloniaVersion>
    <AvaloniaWebViewVersion>11.0.0.1</AvaloniaWebViewVersion>
    <MarkdigVersion>1.3.2</MarkdigVersion>
    <HtmlAgilityPackVersion>1.13.0</HtmlAgilityPackVersion>
    <MicrosoftExtensionsVersion>10.0.0</MicrosoftExtensionsVersion>
  </PropertyGroup>

  <!-- Machine-specific paths (JDK/Android SDK locations) live in a git-ignored file so they
       never end up in version control. See README section 4. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

</Project>
