<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RioEditor.App.ViewModels"
             xmlns:views="clr-namespace:RioEditor.App.Views"
             x:Class="RioEditor.App.Views.MainView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True">

  <!-- Shortcuts live on the shell so they work regardless of focus. -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewDocument}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding Open}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding Save}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAs}" />
    <KeyBinding Gesture="Ctrl+Alt+T" Command="{Binding ToggleTheme}" />
    <KeyBinding Gesture="Ctrl+P" Command="{Binding ExportPdf}" />
    <KeyBinding Gesture="Ctrl+Shift+E" Command="{Binding ExportHtml}" />
  </UserControl.KeyBindings>

  <DockPanel LastChildFill="True">

    <!-- ===== Top chrome ====================================================
         Two layouts, one visible at a time: a single row on desktop, and a compact
         two-row arrangement below the width breakpoint (see MainView.axaml.cs). -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,0,1">
      <StackPanel>

        <!-- Wide: file commands, formatting toolbar and theme all on one row. -->
        <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding !IsCompact}">

          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" Margin="8,6" VerticalAlignment="Center">
            <Button Classes="tool wide" Command="{Binding NewDocument}" Content="New" ToolTip.Tip="New (Ctrl+N)" />
            <Button Classes="tool wide" Command="{Binding Open}" Content="Open" ToolTip.Tip="Open (Ctrl+O)" />
            <Button Classes="tool wide" Command="{Binding Save}" Content="Save" ToolTip.Tip="Save (Ctrl+S)" />
            <Button Classes="tool wide" Command="{Binding SaveAs}" Content="Save As" ToolTip.Tip="Save As (Ctrl+Shift+S)" />
            <Separator Classes="tool" />
            <Button Classes="tool wide" Command="{Binding ExportHtml}" Content="HTML"
                    ToolTip.Tip="Export as a self-contained HTML file" />
            <Button Classes="tool wide" Command="{Binding ExportPdf}" Content="PDF"
                    ToolTip.Tip="Export as PDF (Ctrl+P)" />
            <Separator Classes="tool" />
          </StackPanel>

          <views:ToolbarView Grid.Column="1" DataContext="{Binding Toolbar}" />

          <Button Grid.Column="2" Classes="tool" Margin="8,6"
                  Command="{Binding ToggleTheme}"
                  ToolTip.Tip="Toggle light / dark (Ctrl+Alt+T)">
            <TextBlock Text="◐" FontSize="15" />
          </Button>
        </Grid>

        <!-- Compact row 1: the file commands collapse into a menu, which leaves room for
             the document name and keeps the theme toggle reachable by thumb. -->
        <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsCompact}" Margin="6,4">

          <Button Grid.Column="0" Classes="tool touch"
                  Classes.active="{Binding IsFileMenuOpen}"
                  Command="{Binding ToggleFileMenu}"
                  ToolTip.Tip="File">
            <TextBlock Text="☰" FontSize="17" />
          </Button>

          <TextBlock Grid.Column="1"
                     Text="{Binding Document.FileName}"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     FontWeight="SemiBold"
                     Margin="8,0" />

          <Button Grid.Column="2" Classes="tool touch" Command="{Binding ToggleTheme}" ToolTip.Tip="Toggle theme">
            <TextBlock Text="◐" FontSize="17" />
          </Button>
        </Grid>

        <!-- Compact file menu. An inline row, not a Flyout: a popup here would be drawn behind
             the native WebView. Keeping it in the chrome guarantees it stays visible. -->
        <Border IsVisible="{Binding IsFileMenuOpen}"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                Padding="6,4">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="tool wide touch" Command="{Binding NewDocument}" Content="New" />
            <Button Classes="tool wide touch" Command="{Binding Open}" Content="Open" />
            <Button Classes="tool wide touch" Command="{Binding Save}" Content="Save" />
            <Button Classes="tool wide touch" Command="{Binding SaveAs}" Content="Save As" />
            <Button Classes="tool wide touch" Command="{Binding ExportHtml}" Content="HTML" />
            <Button Classes="tool wide touch" Command="{Binding ExportPdf}" Content="PDF" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- Compact row 2: the formatting bar gets the full width to scroll in. -->
        <views:ToolbarView DataContext="{Binding Toolbar}" IsVisible="{Binding IsCompact}" />

      </StackPanel>
    </Border>


    <!-- ===== Status bar ==================================================== -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,5">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12" Opacity="0.75" />
        <TextBlock Grid.Column="1" Text="{Binding Document.FileName}" FontSize="12" Opacity="0.75" />
      </Grid>
    </Border>

    <!-- ===== The editing surface ==========================================
         Filled at runtime with the platform WebView (desktop) or the overlaid
         iframe host (WASM); see MainView.axaml.cs. -->
    <Panel>
      <ContentControl x:Name="EditorHost" />

      <!-- Shown only when no WebView backend could be created. -->
      <Border x:Name="SurfaceFallback"
              IsVisible="False"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              Padding="32">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="520">
          <TextBlock Text="The editing surface could not start"
                     FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock x:Name="SurfaceFallbackReason"
                     TextWrapping="Wrap" HorizontalAlignment="Center" Opacity="0.8" />
        </StackPanel>
      </Border>
    </Panel>

  </DockPanel>
</UserControl>
