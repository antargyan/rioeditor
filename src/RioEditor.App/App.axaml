<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RioEditor.App"
             x:Class="RioEditor.App.App"
             RequestedThemeVariant="Light">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />

    <!-- Toolbar buttons: flat, square, quiet until hovered. -->
    <Style Selector="Button.tool">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.tool.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight2}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Compact / touch layout: 44px targets, the platform minimum for a comfortable tap. -->
    <Style Selector="Button.tool.touch">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
    </Style>
    <Style Selector="UserControl.compact Button.tool">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="UserControl.compact Separator.tool">
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="8,0" />
    </Style>

    <Style Selector="Button.tool.wide">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <!-- Declared after .touch so a labelled button keeps its intrinsic width. -->
    <Style Selector="Button.tool.touch.wide">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style Selector="Separator.tool">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
  </Application.Styles>

</Application>
