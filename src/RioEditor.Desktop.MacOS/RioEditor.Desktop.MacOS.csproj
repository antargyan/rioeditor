<Project Sdk="Microsoft.NET.Sdk">

  <!--
    macOS desktop head.

    Targets net10.0-macos rather than plain net10.0 so it can use the modern .NET AppKit/WebKit
    bindings and host a real WKWebView. The cross-platform RioEditor.Desktop head keeps using
    WebView.Avalonia for Windows (WebView2) and Linux (WebKitGTK); only macOS needs this.

    Requires the macOS workload:  sudo dotnet workload install macos
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-macos</TargetFramework>
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <RootNamespace>RioEditor.Desktop.MacOS</RootNamespace>
    <AssemblyName>RioEditor</AssemblyName>
    <ApplicationTitle>RioEditor</ApplicationTitle>
    <ApplicationId>ai.rioeditor.editor</ApplicationId>
    <!-- Avalonia owns the NSApplication run loop; the SDK must not generate its own entry point. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="ReactiveUI" Version="$(ReactiveUIVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RioEditor.App\RioEditor.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- actool compiles this into Assets.car + AppIcon.icns; Info.plist's CFBundleIconName
         selects it. Note that a stale obj/ will silently skip the catalog — clean if the icon
         does not appear. -->
    <ImageAsset Include="Assets.xcassets\**\*.png" />
    <ImageAsset Include="Assets.xcassets\**\Contents.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- One WKWebView surface, shared with the iOS head; the differences are two #if switches. -->
    <Compile Include="..\Shared.WebKit\WkWebViewEditorSurface.cs" Link="WkWebViewEditorSurface.cs" />
  </ItemGroup>

</Project>
