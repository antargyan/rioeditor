<Project Sdk="Microsoft.NET.Sdk">

  <!--
    iOS head. Uses the same native WKWebView surface as the macOS head (see Shared.WebKit),
    because WKWebView is a UIView here and an NSView there — otherwise identical.
    Requires:  sudo dotnet workload install ios
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <RootNamespace>RioEditor.iOS</RootNamespace>
    <AssemblyName>RioEditor</AssemblyName>
    <ApplicationTitle>RioEditor</ApplicationTitle>
    <ApplicationId>ai.rioeditor.editor</ApplicationId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.iOS" Version="$(AvaloniaVersion)" />
    <PackageReference Include="ReactiveUI" Version="$(ReactiveUIVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RioEditor.App\RioEditor.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared.WebKit\WkWebViewEditorSurface.cs" Link="WkWebViewEditorSurface.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Info.plist's XSAppIconAssets selects AppIcon from this catalog. -->
    <ImageAsset Include="Assets.xcassets\**\*.png" />
    <ImageAsset Include="Assets.xcassets\**\Contents.json" />
  </ItemGroup>

</Project>
