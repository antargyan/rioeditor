<Project>

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <!--
    Single source of truth for the product version.

    RioVersion is the semantic, user-visible version. RioBuild is the STORE UPLOAD COUNTER: every
    store refuses an upload whose build number it has already seen, and all three read this one
    property.

        Google Play       android:versionCode              <- ApplicationVersion <- RioBuild
        App Store         CFBundleVersion                  <- ApplicationVersion <- RioBuild
        Microsoft Store   third field of the MSIX version                        <- RioBuild

    RioBuild must ONLY EVER INCREASE, and must never reset when RioVersion changes. The Microsoft
    Store compares whole package versions, so a reset would produce a version lower than one
    already published and the upload would bounce. Bump it with:

        powershell.exe -ExecutionPolicy Bypass -File packaging/bump-build.ps1

    Both are plain properties, so CI can override them from a tag without editing anything:

        dotnet build -p:RioVersion=1.2.0 -p:RioBuild=57

    (Command-line properties are global in MSBuild and win over the values below.)
  -->
  <PropertyGroup>
    <RioVersion>1.0.0</RioVersion>
    <RioBuild>2</RioBuild>

    <!-- .NET assembly identity -->
    <Version>$(RioVersion)</Version>
    <AssemblyVersion>$(RioVersion).0</AssemblyVersion>
    <FileVersion>$(RioVersion).$(RioBuild)</FileVersion>
    <InformationalVersion>$(RioVersion)</InformationalVersion>

    <!-- Apple: CFBundleShortVersionString / CFBundleVersion.
         Android: android:versionName / android:versionCode.
         The platform SDKs map these two properties onto those fields. -->
    <ApplicationDisplayVersion>$(RioVersion)</ApplicationDisplayVersion>
    <ApplicationVersion>$(RioBuild)</ApplicationVersion>
  </PropertyGroup>

  <!-- Single source of truth for every third-party version used by the solution. -->
  <PropertyGroup>
    <AvaloniaVersion>12.1.2</AvaloniaVersion>
    <AvaloniaWebViewVersion>12.1.0</AvaloniaWebViewVersion>
    <!--
      ReactiveUI referenced directly, without the Avalonia integration package.
      ReactiveUI.Avalonia (the successor to Avalonia.ReactiveUI) pulls ReactiveUI 24, which has
      replaced Rx entirely with its own Signals model — Observable, Unit, CompositeDisposable and
      System.Reactive all gone. That is a rewrite of this app's reactive plumbing, not an upgrade.
      The only thing the integration package gave us was UseReactiveUI() setting
      RxApp.MainThreadScheduler; we now marshal through Dispatcher.UIThread directly, which is
      both smaller and more obvious. Nothing else in it was used: no IViewFor, no WhenActivated,
      no ReactiveUserControl.
    -->
    <ReactiveUIVersion>20.1.1</ReactiveUIVersion>
    <MarkdigVersion>1.3.2</MarkdigVersion>
    <HtmlAgilityPackVersion>1.13.0</HtmlAgilityPackVersion>
    <MicrosoftExtensionsVersion>10.0.0</MicrosoftExtensionsVersion>

  </PropertyGroup>

  <!-- Machine-specific paths (JDK/Android SDK locations) live in a git-ignored file so they
       never end up in version control. See README section 4. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

</Project>
