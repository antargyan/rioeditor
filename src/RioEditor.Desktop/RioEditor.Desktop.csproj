<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RioEditor.Desktop</RootNamespace>
    <AssemblyName>RioEditor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embedded in the .exe; the in-window icon comes from Assets/icon.png. -->
    <ApplicationIcon>RioEditor.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="ReactiveUI" Version="$(ReactiveUIVersion)" />

    <!-- Native WebView backends: WebView2 on Windows, WebKitGTK on Linux. -->
    <PackageReference Include="Avalonia.Controls.WebView" Version="$(AvaloniaWebViewVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RioEditor.App\RioEditor.App.csproj" />
  </ItemGroup>

</Project>
